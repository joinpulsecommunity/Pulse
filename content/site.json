      {
        "title": "Our Mission",
        "text": "To connect students with meaningful ways to serve, and to develop the leaders our community needs."
      },
      {
        "title": "Our Vision",
        "text": "A school and community where service is a shared habit, and every student believes they can make a difference."
      },
      {
        "title": "Our Values",
        "text": "Compassion, integrity, teamwork, and a commitment to showing up for others."
      }
